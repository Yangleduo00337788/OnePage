# 复制为同目录 .env（不要提交）。yml 只引用这些名字，进程环境变量注入，和应用上线方式相同。
# 本地：十个主类运行配置（含 Search 8087、Ai 8088、Live 8089）→ Modify options → Environment files，指向本文件。
# 上线：K8s / 主机环境变量，不要带 .env 进镜像。
# 密码改成你本机 MySQL / Redis / Nacos / MinIO 的值。

# ---------- 进程端口（IDEA 每个主类监听；网关对外 8080）----------
# 网关 HTTP，浏览器只打这一端口
GATEWAY_PORT=8080
# 认证服务（短信/OAuth/Session）
AUTH_PORT=8081
# 用户资料服务
USER_PORT=8082
# 内容服务（帖子/媒体）
CONTENT_PORT=8083
# 通知服务
NOTIFY_PORT=8084
# 私信服务
MESSAGE_PORT=8085
# 治理服务（举报入库 + 运营 /ops）
MODERATION_PORT=8086
# 搜索服务（全局搜索，索引在 ES）
SEARCH_PORT=8087
# AI 服务（润色 / 耶耶；HTTP 调兼容 OpenAI 的 Chat Completions）
AI_PORT=8088
# 直播服务
LIVE_PORT=8089

# ---------- Nacos（服务发现；本机 IPv4:8848 常被占用，HTTP 走 [::1]:8848；不要改成 8849）----------
# Nacos 地址 host:port
NACOS_SERVER_ADDR=[::1]:8848
# 命名空间
NACOS_NAMESPACE=public
# 分组
NACOS_GROUP=DEFAULT_GROUP
# Nacos 控制台账号
NACOS_USERNAME=nacos
# Nacos 控制台密码
NACOS_PASSWORD=admin123

# ---------- Redis（Session + 网关限流 + 短信验证码 + 私信 WS 路由）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 密码，无密码则留空
REDIS_PASSWORD=admin123
# Cookie Session 有效期（Spring Duration，如 7d）
SESSION_TIMEOUT=7d
# 浏览器 Cookie 名，须与网关一致。C 端（社区+创作者）用这一张
SESSION_COOKIE_NAME=ONEPAGE_SESSION
# 运营后台 Cookie；与 C 端同 host 时互不覆盖
SESSION_OPS_COOKIE_NAME=ONEPAGE_OPS_SESSION
# 仅 HTTPS 才带 Cookie；本机 http 必须 false
SESSION_COOKIE_SECURE=false

# ---------- MySQL（每个服务一个库）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
# 认证库
MYSQL_AUTH_DB=onepage_auth
# 用户库
MYSQL_USER_DB=onepage_user
# 内容库
MYSQL_CONTENT_DB=onepage_content
# 通知库
MYSQL_NOTIFY_DB=onepage_notification
# 私信库
MYSQL_MESSAGE_DB=onepage_message
# 治理库（举报表 report）
MYSQL_MODERATION_DB=onepage_moderation
# 直播库
MYSQL_LIVE_DB=onepage_live

# ---------- 服务间内部调用 ----------
# Feign /internal 校验，各服务必须同一值
INTERNAL_TOKEN=onepage-dev-internal

# 运营员工 userId，逗号分隔。空则运营登录与 /ops 全部 403。须填真实 userId，不要写死在代码里
OPS_STAFF_USER_IDS=

# ---------- 前端与 CORS ----------
# 认证回调等默认前端地址（社区壳）
FRONTEND_URL=http://localhost:5174
# 允许带 Cookie 的 Origin，逗号分隔，不能写 *。5173 文档壳 / 5174 社区 / 5175 创作者 / 5176 运营
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# ---------- Gateway 超时 / 重试 / 限流 ----------
# 连下游超时（毫秒）
GW_CONNECT_TIMEOUT_MS=3000
# 等下游响应超时
GW_RESPONSE_TIMEOUT=10s
# 失败重试次数
GW_RETRY_COUNT=1
# 令牌桶每秒补充
GW_RATE_REPLENISH=50
# 令牌桶突发容量
GW_RATE_BURST=100

# ---------- 短信 ----------
# true=不调真短信，验证码固定为 SMS_MOCK_CODE
SMS_MOCK=true
# mock 验证码（本机登录填这个）
SMS_MOCK_CODE=888888
# 同一手机号发码冷却（秒）
SMS_COOLDOWN_SEC=60

# ---------- OAuth（不配则点击登录返回 CONFIG_MISSING）----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# ---------- MinIO（对象存储；API 9000，不是控制台 9001）----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
# 媒体桶名
MINIO_BUCKET=onepage-media
# 预签名 URL 有效秒数
MINIO_PRESIGN_EXPIRY_SEC=600
# 浏览器拼媒体公开 URL 的前缀
MEDIA_PUBLIC_BASE=http://127.0.0.1:9000/onepage-media

# ---------- Elasticsearch（P3 全局搜索；本机 Docker 单节点 9200）----------
# 例如 http://127.0.0.1:9200 ；WSL Docker 把 9200 映射到 Windows
# 本机 WSL Docker 只通 IPv6；不要写 127.0.0.1（会超时/复位）
ES_URIS=http://[::1]:9200
# 开了 xpack.security 才填；没开账密则留空
ES_USERNAME=elastic
ES_PASSWORD=admin123

# ---------- LLM（P3 耶耶 / 发帖润色；兼容 OpenAI Chat Completions）----------
# 例如 https://api.openai.com/v1 ；不要末尾斜杠
LLM_BASE_URL=https://api.openai.com/v1
# 密钥留空则润色 503、耶耶回复「暂时不能回答」，不编造
LLM_API_KEY=
# 模型名，随上游而定
LLM_MODEL=gpt-4o-mini

# ---------- 直播推流（P4；本仓不内嵌媒体服务器）----------
# 本机可用 MediaMTX：RTMP :1935、HLS :8888。VLC 播 http://127.0.0.1:8888/live/<key>/index.m3u8
# MediaMTX 默认 hlsVariant=lowLatency，VLC 常黑屏，改 mpegts 即可。不要把 HLS 绑到网关 8080。
LIVE_PUSH_BASE=rtmp://127.0.0.1/live
LIVE_HLS_BASE=http://127.0.0.1:8888/live
# OBS 停推后多少秒自动关播；15 秒内再推同一密钥会取消关播。0 为立刻关。
LIVE_UNPUBLISH_GRACE_SECONDS=15
# 可选。MediaMTX 控制 API（默认 :9997）。空则只轮询 HLS。不必再配 runOnNotReady。
LIVE_MTX_API_BASE=http://127.0.0.1:9997
