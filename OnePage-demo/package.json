{
  "name": "onepage-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:community": "vite --config vite/community.ts",
    "dev:creator": "vite --config vite/creator.ts",
    "dev:ops": "vite --config vite/ops.ts",
    "build:media": "node scripts/fetch-local-media.mjs",
    "media:index": "node scripts/rebuild-media-index.mjs",
    "build": "node scripts/run.mjs build && node scripts/assemble.mjs",
    "preview": "node scripts/run.mjs preview"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
